# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Google Maps Platform (browser Maps JS SDK & Places)
VITE_GOOGLE_MAPS_API_KEY=

# Server
NODE_ENV=development
PORT=3000

# Security (REQUIRED in production: generate with `openssl rand -hex 32`)
SESSION_SECRET=
CRON_SECRET=

# MySQL Database (optional in preview; uses persistent SQLite preview adapter when unset)
DATABASE_URL="mysql://u123456789_user:password@127.0.0.1:3306/u123456789_nilelink"

# Persistent File Storage
STORAGE_DIR=

# Optional Real-Time Currency Feed Override (defaults to open.er-api.com + jsdelivr fallback)
FX_API_URL=

# Optional S3-Compatible Object Storage
S3_ENDPOINT=
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# SMTP Email
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM="NileLink <no-reply@yourdomain.com>"

# SMS / OTP Adapter
SMS_PROVIDER=
SMS_API_KEY=
SMS_SENDER_ID=

# Card Payment Gateway Adapter
CARD_GATEWAY_PROVIDER=
CARD_GATEWAY_MERCHANT_ID=
CARD_GATEWAY_API_KEY=
CARD_GATEWAY_SECRET_KEY=
